---
import Layout from '../layouts/Layout.astro';

/** After submit, return to contact (FormSubmit needs an absolute URL; used if JS is off). */
const origin = Astro.site?.origin ?? Astro.url.origin;
const contactThankYou = new URL('/contact?sent=1', origin).href;
const showSentConfirmation = Astro.url.searchParams.get('sent') === '1';

const thankYouCopy =
  "Thank you. Your message has been sent. I'll get back to you as soon as I can.";

/** FormSubmit AJAX endpoint — avoids redirect to FormSubmit’s separate captcha page. */
const formSubmitAjax = 'https://formsubmit.co/ajax/connect@lilidavid.com';

/** Optional: add PUBLIC_TURNSTILE_SITE_KEY in .env for a verification widget on this page. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Layout
  title="Contact — Lili David"
  description="Get in touch with Lili David — facilitator, consultant, and coach."
>

  <section class="page-hero section contact-hero">
    <div class="container">
      <h1>Get in touch</h1>
      <p class="lead mt-md contact-hero-lead">
        If you&rsquo;re trying to build a way of working that is both effective and human,
        I&rsquo;d be glad to hear more about your context. There&rsquo;s no obligation —
        an initial conversation is simply a chance to understand each other&rsquo;s situations.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      {showSentConfirmation && (
        <p class="contact-sent-note" role="status">
          {thankYouCopy}
        </p>
      )}
      <div class="contact-grid">

        <div class="contact-form-wrap">
          <h2 class="contact-form-title">Send a message</h2>

          {!showSentConfirmation && (
            <>
              <p id="contact-form-success" class="contact-sent-note" role="status" tabindex="-1" hidden>
                {thankYouCopy}
              </p>
              <p
                id="contact-form-error"
                class="contact-form-error"
                role="alert"
                tabindex="-1"
                hidden
              ></p>

              <p id="contact-form-note" class="contact-form-note">
                I aim to respond to all messages within two working days.
                If your situation is time-sensitive, please mention it in your message.
              </p>

              <form
                id="contact-form"
                class="contact-form"
                action="https://formsubmit.co/connect@lilidavid.com"
                method="POST"
                aria-describedby="contact-form-note"
              >
                <input type="hidden" name="_subject" value="Message from lilidavid.com contact form" />
                <input type="hidden" name="_template" value="table" />
                <input type="hidden" name="_next" value={contactThankYou} />
                <input
                  type="text"
                  name="_honey"
                  class="contact-honeypot"
                  tabindex="-1"
                  autocomplete="off"
                  aria-hidden="true"
                />
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Your name <span class="required">*</span></label>
                <input
                  class="form-input"
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Jane Smith"
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email address <span class="required">*</span></label>
                <input
                  class="form-input"
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="jane@example.com"
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="organisation">Organisation <span class="optional">(optional)</span></label>
              <input
                class="form-input"
                id="organisation"
                name="organisation"
                type="text"
                autocomplete="organization"
                placeholder="Your company or team"
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Your message <span class="required">*</span></label>
              <textarea
                class="form-textarea"
                id="message"
                name="message"
                required
                rows="6"
                placeholder="Tell me a little about your situation and what you're hoping for…"
              ></textarea>
            </div>

            {turnstileSiteKey ? (
              <>
                <div
                  class="cf-turnstile contact-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-theme="light"
                ></div>
                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
              </>
            ) : null}

            <button class="btn btn--primary contact-submit-btn" type="submit" style="margin-top: 0.5rem;">
              Send message
            </button>

            <p class="contact-privacy-note">
              Your information will be used only to respond to your enquiry. See the
              <a href="/privacy">Privacy Policy</a> for details.
            </p>
              </form>
            </>
          )}
        </div>

        <!-- ASIDE -->
        <aside class="contact-aside">

          <div id="schedule" class="service-card">
            <h3>Schedule a conversation</h3>
            <p>
              Prefer to find a time directly? You can book a 45 minute exploratory
              call using the scheduler below.
            </p>
            <button
              type="button"
              class="btn btn--primary mt-sm contact-aside-btn"
              data-open-booking
            >
              Book a call &rarr;
            </button>
          </div>

          <div class="service-card">
            <h3>Connect on LinkedIn</h3>
            <p>
              I&rsquo;m quite active on LinkedIn and regularly share reflections and practical
              insights from my work with teams and organisations.
            </p>
            <a
              href="https://www.linkedin.com/in/lilidavidis/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary mt-sm contact-aside-btn"
              aria-label="Follow on LinkedIn (opens in a new tab)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0;">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Follow on LinkedIn &#8599;
            </a>
          </div>

          <div class="aside-legal" aria-label="Company details">
            <h3>Company details</h3>
            <p class="aside-legal-line">CoherentOrgs SRL</p>
            <p class="aside-legal-line">Str Ion Lahovari 23B/2, Dumbraveni, Romania</p>
            <p class="aside-legal-line">Registration Number: RO54128042</p>
          </div>

        </aside>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ formSubmitAjax, turnstileSiteKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    if (!form) return;

    const fieldIds = ['name', 'email', 'message'];

    function setFormDescribedBy(includeError) {
      form.setAttribute(
        'aria-describedby',
        includeError ? 'contact-form-note contact-form-error' : 'contact-form-note',
      );
    }

    function clearSubmissionErrorState() {
      fieldIds.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.removeAttribute('aria-invalid');
        el.classList.remove('form-input--error');
      });
    }

    function setFieldsInvalid(invalid) {
      fieldIds.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        if (invalid) {
          el.setAttribute('aria-invalid', 'true');
          el.classList.add('form-input--error');
        } else {
          el.removeAttribute('aria-invalid');
          el.classList.remove('form-input--error');
        }
      });
    }

    function showErrorMessage(message, markFieldsInvalid) {
      const errorEl = document.getElementById('contact-form-error');
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
      setFormDescribedBy(true);
      if (markFieldsInvalid) setFieldsInvalid(true);
      requestAnimationFrame(() => {
        errorEl.focus();
      });
    }

    function hideErrorMessage() {
      const errorEl = document.getElementById('contact-form-error');
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
      setFormDescribedBy(false);
      clearSubmissionErrorState();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const successEl = document.getElementById('contact-form-success');
      const submitBtn = form.querySelector('button[type="submit"]');

      const turnstileInput = form.querySelector('input[name="cf-turnstile-response"]');
      if (turnstileSiteKey && (!turnstileInput || !turnstileInput.value)) {
        showErrorMessage('Please complete the verification step above.', false);
        return;
      }

      hideErrorMessage();

      const fd = new FormData(form);
      /* `_next` is for full-page POST redirects; the AJAX endpoint ignores it and it can confuse the API. */
      fd.delete('_next');

      const prevLabel = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const res = await fetch(formSubmitAjax, {
          method: 'POST',
          body: fd,
          headers: {
            Accept: 'application/json, text/plain, */*',
          },
        });

        const raw = await res.text();
        let data = null;
        const trimmed = raw.trim();
        if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
          try {
            data = JSON.parse(raw);
          } catch {
            data = null;
          }
        }

        if (data) {
          const failed = data.success === 'false' || data.success === false;
          if (!res.ok || failed) {
            throw new Error(
              data.message || 'Could not send your message. Please try again.',
            );
          }
        } else if (!res.ok) {
          throw new Error('Could not send your message. Please try again.');
        }
        /* Some FormSubmit responses return JSON in the body but `Content-Type: text/html`; treat OK + non-JSON as success only when status is 2xx. */
        else if (
          res.ok &&
          (trimmed.length === 0 ||
            /success|thank you|submitted/i.test(raw) ||
            res.status === 200)
        ) {
          /* accepted */
        } else {
          throw new Error('Unexpected response from form service. If this persists, email connect@lilidavid.com directly.');
        }

        form.hidden = true;
        const note = form.previousElementSibling;
        if (note && note.classList && note.classList.contains('contact-form-note')) {
          note.hidden = true;
        }
        const wrap = form.closest('.contact-form-wrap');
        const title = wrap && wrap.querySelector('.contact-form-title');
        if (title) title.hidden = true;

        if (successEl) {
          successEl.hidden = false;
          requestAnimationFrame(() => {
            successEl.focus();
          });
        }
      } catch (err) {
        const msg =
          err instanceof Error
            ? err.message
            : 'Something went wrong. You can also email connect@lilidavid.com directly.';
        showErrorMessage(msg, true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = prevLabel || 'Send message';
        }
      }
    });
  });
</script>

<style>
  /* Tighter gap between hero and form (default .section stacks two --space-xl) */
  .contact-hero.page-hero {
    padding-bottom: var(--space-md);
  }

  /* Match default `.container` width — override global `p.lead` 58ch; ~20% narrower than full column */
  .contact-hero-lead {
    max-width: 80%;
  }

  .contact-section.section {
    padding-top: var(--space-md);
  }

  .contact-form-wrap {
    position: relative;
  }

  .contact-sent-note {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    margin-bottom: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--eucalyptus-light);
    border: 1px solid var(--eucalyptus-mid);
    border-radius: 2px;
  }

  .contact-form-error {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    margin-bottom: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.9rem;
    color: #8a3a3a;
    background: #fdf3f3;
    border: 1px solid #e5bcbc;
    border-radius: 2px;
  }

  .contact-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .contact-turnstile {
    margin-top: 0.25rem;
  }

  .contact-submit-btn {
    align-self: flex-start;
    width: auto;
    padding-inline: 1.35rem;
  }

  .contact-privacy-note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
    max-width: none;
  }

  .contact-privacy-note a {
    color: var(--ink-soft);
    text-underline-offset: 0.16em;
  }

  .contact-privacy-note a:hover {
    color: #3F5648;
  }

  .contact-grid {
    display: grid;
    /* Slightly wider form column, slightly narrower aside (white cards) */
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: var(--space-xl);
    align-items: start;
  }

  /* Match global `.service-card h3` (e.g. “Schedule a conversation”) */
  .contact-form-title {
    margin-top: 0;
    margin-bottom: calc(var(--space-sm) + 0.45rem);
    font-size: 1.52rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    position: relative;
  }

  .contact-form-note {
    margin: 0 0 var(--space-md);
    max-width: none;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
  }

  :global(.contact-form) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.form-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  :global(.contact-form .form-group) {
    min-width: 0;
  }

  :global(.required) {
    color: var(--slate);
  }

  :global(.optional) {
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-weight: 400;
  }

  /* ASIDE — Schedule + LinkedIn use global `.service-card` (same white cards as home) */
  .contact-aside {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-md));
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .aside-legal {
    padding: var(--space-md);
    background: transparent;
    border: 1px solid var(--stone-dark);
  }

  .aside-legal h3 {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .aside-legal-line {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-soft);
    font-style: normal;
  }

  .aside-legal-line + .aside-legal-line {
    margin-top: 0.35rem;
  }

  .contact-aside .contact-aside-btn {
    align-self: flex-start;
    width: fit-content;
    max-width: 100%;
    padding-inline: 1.1rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .contact-aside {
      position: static;
    }

    :global(.form-row) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .contact-hero.page-hero {
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-md);
    }

    .contact-section.section {
      padding-block: var(--space-md);
    }

    .contact-turnstile {
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .contact-submit-btn {
      width: 100%;
      max-width: 100%;
      justify-content: center;
      min-height: 2.75rem;
    }
  }

  @media (max-width: 380px) {
    .contact-sent-note,
    .contact-form-error {
      padding: var(--space-sm);
      font-size: 0.875rem;
    }
  }
</style>

