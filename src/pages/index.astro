---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lili David — Facilitator, Consultant & Coach">

  <!-- ===================================================
       1. HERO
       =================================================== -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="label hero-anim hero-anim--1">Facilitator &middot; Consultant &middot; Coach</span>
        <h1 class="hero-headline hero-anim hero-anim--2">
          Transform the underlying <em class="accent-word">patterns</em><br class="break" />
          that keep teams stuck
        </h1>
        <p class="lead hero-sub hero-anim hero-anim--3">
          I help organizations reshape the structures, habits, and interactions
          that get in the way of clarity, shared responsibility, and greater effectiveness.
        </p>
        <div class="flex-row mt-md hero-anim hero-anim--4">
          <a href="/contact" class="btn btn--primary">Let&rsquo;s talk</a>
          <a href="/working-together" class="hero-secondary-link">Working Together &rarr;</a>
        </div>
      </div>

      <div class="hero-photo-wrap hero-anim hero-anim--2">
        <img
          src="/images/lili-hero-GIF.gif?v=20260401"
          alt="Portrait of Lili David"
          class="hero-photo"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Animated wavy accent line -->
  <div class="wave-wrap" aria-hidden="true">
    <div class="wave-clip">
      <svg id="accent-wave-svg" xmlns="http://www.w3.org/2000/svg"
           height="16">
        <defs>
          <linearGradient id="waveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#5B7E6F" />
            <stop offset="100%" stop-color="#4A6B8A" />
          </linearGradient>
        </defs>
        <path id="accent-wave-path" fill="none"
              stroke="url(#waveGrad)" stroke-width="2"
              stroke-linecap="butt" />
      </svg>
    </div>
  </div>

  <!-- ===================================================
       2. TWO EXTREMES
       =================================================== -->
  <section class="section section--alt extremes-section">
    <div class="container">
      <div class="text-center mb-lg" data-animate="fade-up">
        <span class="label">The problem</span>
        <h2>Where organizations lose <em class="accent-word">balance</em></h2>
        <p class="lead mt-sm" style="margin-inline: auto;">
          Many organizations get stuck at one of two extremes:
        </p>
      </div>

      <div class="extremes-grid">
        <div class="extreme-unit extreme-unit--eucalyptus" data-animate="fade-right">
          <span class="extreme-weight" aria-hidden="true">&#9670;</span>
          <div class="extreme-card extreme-card--eucalyptus">
            <h3>Focused on <em class="accent-word">inclusion</em>,<br />but lacking clarity and traction</h3>
            <p>
              The organization values participation and care — but roles are unclear,
              meetings drain energy, progress is slow, and key priorities slip.
            </p>
          </div>
        </div>

        <div class="extremes-divider" aria-hidden="true" data-animate="divider">
          <div class="extremes-line extremes-line--a"></div>
          <span class="extremes-or accent-word">or</span>
          <div class="extremes-line extremes-line--b"></div>
        </div>

        <div class="extreme-unit extreme-unit--slate" data-animate="fade-left">
          <span class="extreme-weight" aria-hidden="true">&#9670;</span>
          <div class="extreme-card extreme-card--slate">
            <h3>Focused on <em class="accent-word">performance</em>,<br />but low in ownership and engagement</h3>
            <p>
              The organization values efficiency and output — but leadership is overloaded,
              decisions lack buy-in, tensions rise, and people disengage.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       3. BRIDGE — BEST OF BOTH
       =================================================== -->
  <section class="section bridge-section">
    <div class="container">
      <div class="text-center mb-lg" data-animate="fade-up">
        <span class="label">The bridge</span>
        <h2>What it takes to have the best of both?</h2>
      </div>

      <div class="bridge-grid">
        <div class="bridge-card bridge-card--eucalyptus">
          <div class="bridge-card-content">
            <h4 class="bridge-card-label">When inclusion is ↑ but clarity is ↓</h4>
            <p>
              What helps is more <strong class="accent-word">structure</strong>: clearer roles and
              structures, stronger meeting practices, and agreements that sustain momentum.
            </p>
          </div>
        </div>

        <div class="bridge-card bridge-card--slate">
          <div class="bridge-card-content">
            <h4 class="bridge-card-label">When performance is ↑ but ownership is ↓</h4>
            <p>
              What helps is more <strong class="accent-word">participation</strong>: healthier
              communication, more transparency and collaborative decisions that people truly support.
            </p>
          </div>
        </div>

        <div class="bridge-arrows" aria-hidden="true" data-animate="fade-up" data-delay="120">
          <span class="bridge-amp">&amp;</span>
        </div>
      </div>

      <div class="bridge-statement-wrap text-center">
        <div class="bridge-statement-card">
          <p class="lead bridge-statement-text" style="margin-inline: auto;">
            The point is to build habits and structures where <strong>effectiveness</strong> and
            <strong>care</strong> reinforce each other.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       4. HOW I HELP — SERVICES
       =================================================== -->
  <section class="section section--alt">
    <div class="container">
      <div class="text-center mb-lg" data-animate="fade-up">
        <span class="label">Working Together</span>
        <h2>Three ways of working together</h2>
      </div>

      <div class="services-grid">
        <div class="service-card" data-animate="fade-up" data-delay="0">
          <h3>Facilitation</h3>
          <p>
            I support groups in designing and running engaging meetings that are
            purposeful, well-structured, and highly effective.
          </p>
          <a href="/working-together#facilitation" class="service-link">Learn more &rarr;</a>
        </div>

        <div class="service-card" data-animate="fade-up" data-delay="100">
          <h3>Consulting</h3>
          <p>
            I work more deeply with organizations that want to understand and address
            the core issues behind recurring challenges.
          </p>
          <a href="/working-together#consulting" class="service-link">Learn more &rarr;</a>
        </div>

        <div class="service-card" data-animate="fade-up" data-delay="200">
          <h3>Coaching</h3>
          <p>
            I support leaders and teams who want to better understand how their own
            behaviour influences team dynamics and outcomes — one-to-one or in a group
            setting.
          </p>
          <a href="/working-together#coaching" class="service-link">Learn more &rarr;</a>
        </div>
      </div>

      <p class="services-framing mt-lg text-center" style="margin-inline: auto;" data-animate="fade-up">
        Across all three, I bring a systemic lens and pay attention to the patterns
        and conditions that shape how people work together.
      </p>
    </div>
  </section>

  <!-- ===================================================
       BLEND BAR
       =================================================== -->
  <div class="blend-bar">
    <div class="blend-bar-gradient" aria-hidden="true"></div>
    <div class="container">
      <p class="blend-text">
        <span class="blend-slot blend-slot--left">
          <span class="blend-sharp">Sharp thinking</span>
        </span>
        <span class="blend-rule" aria-hidden="true"></span>
        <span class="blend-slot blend-slot--right">
          <span class="blend-human">Deeply human work</span>
        </span>
      </p>
    </div>
  </div>

  <!-- ===================================================
       5. OUTCOMES
       =================================================== -->
  <section class="section outcomes-section">
    <div class="container">
      <div class="outcomes-inner">
        <div class="outcomes-left" data-animate="fade-up">
          <span class="label">What this work makes possible</span>
          <h2>Outcomes</h2>
          <div class="divider divider--center mt-md"></div>
          <p class="mt-md">
            The goal is not only to solve immediate challenges, but to improve how
            your organization works day to day.
          </p>
          <a href="/contact" class="btn btn--primary mt-md">Start a conversation</a>
        </div>
        <ul class="outcomes-list outcomes-right">
          <li data-animate="outcome-right" data-delay="0">Better role clarity and responsibility flow</li>
          <li data-animate="outcome-right" data-delay="60">Clearer decisions and accountability</li>
          <li data-animate="outcome-right" data-delay="120">Stronger ownership and follow-through</li>
          <li data-animate="outcome-right" data-delay="180">More effective, inclusive meetings</li>
          <li data-animate="outcome-right" data-delay="240">Greater transparency and trust</li>
          <li data-animate="outcome-right" data-delay="300">Healthier collaboration across differences</li>
          <li data-animate="outcome-right" data-delay="360">Faster progress with less friction</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================================================
       6. BIO / CREDIBILITY
       =================================================== -->
  <section class="section section--alt bio-section">
    <div class="container">
      <div class="bio-inner">
        <div class="bio-media" data-animate="fade-right">
          <div class="bio-image-stack" aria-hidden="true">
            <img
              src="/images/lili-about-front.png"
              alt=""
              class="bio-image-photo bio-image-single"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="bio-photo-quote">
            I&rsquo;m drawn to the point where thoughtful structure meets the reality of human relationships.
          </p>
        </div>
        <div class="bio-content" data-animate="fade-left">
          <span class="label">About</span>
          <h2 class="bio-headline">What shapes my perspective</h2>
          <p class="mt-md">
            I came to this work through socially oriented and nonprofit projects, where I saw how often
            good intentions were undermined by unhealthy dynamics, fuzzy roles, and meetings with little
            traction. That experience set me on a path toward ways of working that do not force a choice
            between inclusion and effectiveness.
          </p>
          <p class="mt-sm">
            Discovering sociocracy in 2014, and soon after joining the Sociocracy 3.0 development team,
            gave me a practical way forward. It became an important strand in the work I&rsquo;ve continued to
            deepen over the years..
          </p>
          <a href="/about" class="service-link mt-md">More about me &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       7. FINAL CTA
       =================================================== -->
  <section class="section section--dark cta-section">
    <div class="container text-center" data-animate="fade-up">
      <h2 class="cta-headline" style="color: var(--stone);">
        Let&rsquo;s talk <span aria-hidden="true">&#128172;</span>
      </h2>
      <p class="lead mt-md" style="color: var(--stone-mid); margin-inline: auto;">
        I&rsquo;d be glad to hear more about your context.
      </p>
      <div class="flex-row mt-lg" style="justify-content: center;">
        <a href="/contact" class="btn btn--primary" style="background: var(--stone); color: var(--ink);">Get in touch</a>
        <a href="/contact#schedule" class="btn btn--outline-light">Schedule a conversation</a>
      </div>
    </div>
  </section>

</Layout>

<!-- ===================================================
     SCROLL REVEAL
     =================================================== -->
<script>
  // ── Scroll reveal ────────────────────────────────────────────
  const targets = document.querySelectorAll('[data-animate]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.delay ?? '0', 10);
          setTimeout(() => el.classList.add('is-visible'), delay);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  targets.forEach((el) => observer.observe(el));

  // Replay blend-bar animation every time it enters viewport
  const blendBar = document.querySelector('.blend-bar') as HTMLElement | null;
  if (blendBar) {
    const blendObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Restart sequence by toggling class
            blendBar.classList.remove('is-visible');
            // Force reflow so animation restarts reliably
            void blendBar.offsetWidth;
            blendBar.classList.add('is-visible');
          } else {
            blendBar.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.45 }
    );
    blendObserver.observe(blendBar);
  }

  // Replay bridge card animation whenever bridge re-enters viewport
  const bridgeGrid = document.querySelector('.bridge-grid') as HTMLElement | null;
  if (bridgeGrid) {
    const bridgeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bridgeGrid.classList.remove('is-visible');
            void bridgeGrid.offsetWidth;
            bridgeGrid.classList.add('is-visible');
          } else {
            bridgeGrid.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.45 }
    );
    bridgeObserver.observe(bridgeGrid);
  }

  // Scroll-linked "imbalance" motion for the two extremes cards
  // (subtle opposing movement while section is in view)
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    const extremesSection = document.querySelector('.extremes-section') as HTMLElement | null;
    const leftCard = document.querySelector('.extreme-unit--eucalyptus') as HTMLElement | null;
    const rightCard = document.querySelector('.extreme-unit--slate') as HTMLElement | null;

    if (extremesSection && leftCard && rightCard) {
      let ticking = false;
      const maxOffset = 52; // px: +20px more

      const updateImbalance = () => {
        ticking = false;
        const rect = extremesSection.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;

        // Progress from section entering viewport to leaving viewport
        const raw = (vh - rect.top) / (vh + rect.height);
        const progress = Math.max(0, Math.min(1, raw));
        const centered = (progress - 0.5) * 2; // -1..1
        const eased = Math.sin(centered * Math.PI * 0.5); // soften endpoints
        const offset = eased * maxOffset;

        leftCard.style.transform = `translateY(${offset.toFixed(2)}px)`;
        rightCard.style.transform = `translateY(${(-offset).toFixed(2)}px)`;
      };

      const requestUpdate = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateImbalance);
        }
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
      requestUpdate();
    }
  }

  // ── Wavy accent line ─────────────────────────────────────────
  (function () {
    const svg  = document.getElementById('accent-wave-svg') as SVGSVGElement | null;
    const path = document.getElementById('accent-wave-path') as SVGPathElement | null;
    const clip = document.querySelector('.wave-clip') as HTMLElement | null;
    if (!svg || !path || !clip) return;

    requestAnimationFrame(() => {
      // Measure from the wrap parent so width is correct even when clip=0
      const W         = (clip.parentElement as HTMLElement).getBoundingClientRect().width || window.innerWidth;
      const H         = 24;
      const CY        = -2;
      const AMPLITUDE = 4.6;
      const POINTS    = 180;

      // Set SVG to exact pixel dimensions so the path coordinates are correct
      svg.setAttribute('width',   String(W));
      svg.setAttribute('height',  String(H));
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

      function buildFlatPath(): string {
        const pts: string[] = [];
        for (let i = 0; i <= POINTS; i++) {
          const x = (i / POINTS) * W;
          pts.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${CY.toFixed(2)}`);
        }
        return pts.join(' ');
      }

      function buildWavePacketPath(p: number): string {
        const pts: string[] = [];
        const centerX     = W * (0.32 + 0.48 * p);
        const packetWidth = W * 0.34;
        const cycles      = 4.5;
        for (let i = 0; i <= POINTS; i++) {
          const x        = (i / POINTS) * W;
          const dx       = x - centerX;
          const tNorm    = dx / (packetWidth / 2);
          const envelope = Math.exp(-Math.pow(tNorm, 2) * 2.2);
          const wave     = Math.sin(((dx + packetWidth / 2) / packetWidth) * Math.PI * 2 * cycles);
          const y        = CY + AMPLITUDE * wave * envelope;
          pts.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`);
        }
        return pts.join(' ');
      }

      function easeInOut(t: number): number {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      path.setAttribute('d', buildFlatPath());
      clip.style.opacity = '0';
      clip.style.transform = 'translateX(0)';

      const FADE_DELAY     = 700;
      const FADE_DURATION  = 700;
      const MORPH_DURATION = 2100;
      const HOLD_DURATION  = 650;
      const EXIT_DURATION  = 1200;

      type Phase = 'waiting' | 'fading' | 'morphing' | 'holding' | 'exiting' | 'done';
      let phase: Phase         = 'waiting';
      let phaseStart           = 0;
      let animStart: number | null = null;

      function tick(ts: number) {
        if (animStart === null) animStart = ts;

        // ── WAITING ──────────────────────────────────────────
        if (phase === 'waiting') {
          if (ts - animStart >= FADE_DELAY) { phase = 'fading'; phaseStart = ts; }
          requestAnimationFrame(tick);
          return;
        }

        // ── FADING: simple intentional reveal ────────────────
        if (phase === 'fading') {
          const t = Math.min((ts - phaseStart) / FADE_DURATION, 1);
          const eased = easeInOut(t);
          clip.style.opacity = String(eased);
          if (t < 1) { requestAnimationFrame(tick); return; }
          clip.style.opacity = '1';
          phase = 'morphing'; phaseStart = ts;
          requestAnimationFrame(tick);
          return;
        }

        // ── MORPHING: wave packet travels right ───────────────
        if (phase === 'morphing') {
          const t = Math.min((ts - phaseStart) / MORPH_DURATION, 1);
          path.setAttribute('d', buildWavePacketPath(easeInOut(t)));
          if (t < 1) { requestAnimationFrame(tick); return; }
          phase = 'holding'; phaseStart = ts;
          requestAnimationFrame(tick);
          return;
        }

        // ── HOLDING ──────────────────────────────────────────
        if (phase === 'holding') {
          if (ts - phaseStart >= HOLD_DURATION) { phase = 'exiting'; phaseStart = ts; }
          requestAnimationFrame(tick);
          return;
        }

        // ── EXITING: slide off to the right ──────────────────
        if (phase === 'exiting') {
          const t     = Math.min((ts - phaseStart) / EXIT_DURATION, 1);
          const eased = t * t;
          clip.style.transform = `translateX(${110 * eased}%)`;
          clip.style.opacity   = String(Math.max(0, 1 - eased * 1.4));
          if (t < 1) { requestAnimationFrame(tick); return; }
          phase = 'done';
        }
      }

      requestAnimationFrame(tick);
    });
  })();
</script>

<style>
  /* =============================================
     ACCENT WORD — Playfair italic inline accent
     ============================================= */
  .accent-word {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    /* inherit size from parent — no size override */
  }

  /* Remove asymmetry: center text across homepage sections */
  .extreme-card,
  .bridge-card,
  .service-card,
  .outcomes-left,
  .bio-content {
    text-align: center;
  }

  .hero-copy .flex-row {
    justify-content: flex-start;
  }

  /* =============================================
     SCROLL REVEAL — base states
     ============================================= */
  [data-animate] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  [data-animate="fade-right"] { transform: translateX(-32px); }
  [data-animate="fade-left"]  { transform: translateX(32px); }
  [data-animate="outcome-right"] { transform: translateX(-24px); }
  [data-animate="divider"]    { transform: none; }

  [data-animate].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Divider children animate once parent is visible */
  [data-animate="divider"] .extremes-line--a,
  [data-animate="divider"] .extremes-line--b {
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  [data-animate="divider"] .extremes-or {
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.25, 0.1, 0.25, 1) 0.35s;
  }
  [data-animate="divider"].is-visible .extremes-line--a {
    transform: scaleY(1);
    transition-delay: 0.05s;
  }
  [data-animate="divider"].is-visible .extremes-line--b {
    transform: scaleY(1);
    transition-delay: 0.15s;
  }
  [data-animate="divider"].is-visible .extremes-or {
    opacity: 1;
  }

  @media (max-width: 760px) {
    [data-animate="divider"] .extremes-line--a,
    [data-animate="divider"] .extremes-line--b {
      transform: scaleX(0);
      transform-origin: center;
    }
    [data-animate="divider"].is-visible .extremes-line--a,
    [data-animate="divider"].is-visible .extremes-line--b {
      transform: scaleX(1);
    }
  }

  /* =============================================
     HERO — load animations
     ============================================= */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-anim {
    animation: heroFadeUp 0.8s cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  .hero-anim--1 { animation-delay: 0.15s; }
  .hero-anim--2 { animation-delay: 0.28s; }
  .hero-anim--3 { animation-delay: 0.42s; }
  .hero-anim--4 { animation-delay: 0.58s; }

  /* =============================================
     HERO — layout
     ============================================= */

  .hero {
    position: relative;
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-xl);
    overflow-x: hidden;
    overflow-y: visible;
  }

  .hero-inner {
    position: relative;
    width: 100%;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hero-copy {
    min-width: 0;
    max-width: 640px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-photo-wrap {
    position: relative;
    margin-inline: 0;
    margin-top: 0;
    margin-bottom: 0;
    height: 100%;
    width: auto;
    min-width: clamp(230px, 28vw, 320px);
    max-height: 460px;
    aspect-ratio: 4 / 5;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--stone-dark);
    box-shadow: 0 8px 20px rgba(30, 37, 48, 0.1);
    top: 0;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 23% 0%;
    display: block;
    transform: scale(1.14);
    transform-origin: center top;
  }

  .hero-headline {
    margin-top: var(--space-sm);
    font-size: clamp(2.4rem, 5.2vw, 3.75rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.03em;
    /* bleed slightly past the sub-text column for editorial tension */
    max-width: 16ch;
    margin-inline: 0;
  }

  .hero-sub {
    margin-top: var(--space-md);
    max-width: 52ch;
    margin-inline: 0;
  }

  .hero-secondary-link {
    align-self: auto;
    font-family: var(--font-sans);
