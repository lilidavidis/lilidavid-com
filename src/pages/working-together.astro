---
import Layout from '../layouts/Layout.astro';
import { showClientStories } from '../config/site';
import { rich } from '../lib/content';
import copy from '../content/working-together.json';
---

<Layout title={copy.metaTitle} description={copy.metaDescription}>

  <!-- PAGE HERO -->
  <section class="page-hero section">
    <div class="container">
      <h1 class="hero-anim hero-anim--1" set:html={rich(copy.hero.headline)} />
      <p class="lead mt-md hero-anim hero-anim--2">
        {copy.hero.lead}
      </p>
    </div>
  </section>

  <div class="wave-wrap" aria-hidden="true">
    <div class="wave-clip">
      <svg id="help-accent-wave-svg" xmlns="http://www.w3.org/2000/svg" height="16">
        <defs>
          <linearGradient id="helpWaveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#5B7E6F" />
            <stop offset="100%" stop-color="#4A6B8A" />
          </linearGradient>
        </defs>
        <path
          id="help-accent-wave-path"
          fill="none"
          stroke="url(#helpWaveGrad)"
          stroke-width="2"
          stroke-linecap="butt"
        />
      </svg>
    </div>
  </div>

  {copy.services.map((service, index) => (
  <section id={service.id} class={index === 0 || index === 2 ? 'section section--alt service-section' : 'section service-section'}>
    <div class="container">
      <div class="service-layout">
        <div class="service-meta" data-animate="fade-right">
          <h2><span class="service-name-box">{service.name}</span></h2>
          <blockquote class="service-quote service-quote--meta mt-md">
            <span class="service-quote-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9h4v4a4 4 0 0 1-4 4"></path>
                <path d="M14 9h4v4a4 4 0 0 1-4 4"></path>
              </svg>
            </span>
            <p>{service.quote}</p>
          </blockquote>
        </div>
        <div class="service-body" data-animate="fade-left">
          <h3 class="service-intro">
            {service.intro}
          </h3>
          <p class="mt-sm">
            {service.body}
          </p>

          <h4 class="mt-lg subsection-label">{service.whoLabel}</h4>
          <ul class="outcomes-list outcomes-right service-list mt-sm">
            {service.whoItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h4 class="subsection-label">{service.howLabel}</h4>
          <p class="mt-sm">
            {service.howBody}
          </p>
        </div>
      </div>
    </div>
  </section>
  ))}

  {showClientStories && (
  <!-- CASE STUDIES CALLOUT -->
  <section class="section case-callout-section">
    <div class="container text-center" data-animate="fade-up">
      <h2 set:html={rich(copy.caseCallout.headline)} />
      <p class="lead mt-md" style="margin-inline: auto;">
        {copy.caseCallout.lead}
      </p>
      <a href="/client-stories" class="btn btn--primary mt-md">{copy.caseCallout.cta}</a>
    </div>
  </section>
  )}

  <!-- SYSTEMIC BLEND BAR -->
  <div class="hiw-blend-bar">
    <div class="hiw-blend-bar-gradient" aria-hidden="true"></div>
    <div class="container">
      <p class="hiw-blend-text">
        <span class="hiw-blend-slot hiw-blend-slot--left">
          <span class="hiw-blend-sharp">{copy.blendBar.left}</span>
        </span>
        <span class="hiw-blend-rule" aria-hidden="true"></span>
        <span class="hiw-blend-slot hiw-blend-slot--right">
          <span class="hiw-blend-human">{copy.blendBar.right}</span>
        </span>
      </p>
    </div>
  </div>

  <!-- TRAINING APPROACH -->
  <section class="section hiw-training-section">
    <div class="container hiw-training-inner" data-animate="fade-up">
      <h2 set:html={rich(copy.training.headline)} />
      <p class="lead mt-md hiw-copy-narrow">
        {copy.training.lead}
      </p>
      {copy.training.paragraphs.map((p) => (
        <p class="mt-md hiw-copy-wide">{p}</p>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section testimonials-section">
    <div class="container">
      <div class="text-center mb-lg" data-animate="fade-up">
        <h2>{copy.testimonials.headline}</h2>
      </div>
      <div class="testimonials-grid">
        {copy.testimonials.items.map((item, index) => (
        <figure class="service-card testimonial-as-service-card" data-animate="fade-up" data-delay={index > 0 ? String(index * 80) : undefined}>
          <span class="testimonial-mark" aria-hidden="true">&ldquo;</span>
          <blockquote class="testimonial-quote">
            <p>
              {item.quote}
            </p>
          </blockquote>
          <figcaption class="testimonial-attribution testimonial-attribution--anonymous">
            <span class="testimonial-byline">{item.attribution}</span>
          </figcaption>
        </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container">
      <div class="text-center mb-lg" data-animate="fade-up">
        <span class="label">{copy.faq.label}</span>
        <h2>{copy.faq.headline}</h2>
      </div>

      <div class="faq-list" data-animate="fade-up">
        {copy.faq.items.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">{item.question}</summary>
          <div class="faq-answer">
            {item.answer.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section hiw-cta-section">
    <div class="container text-center" data-animate="fade-up">
      <h2 class="hiw-cta-heading">{copy.cta.headline}</h2>
      <p class="lead mt-md hiw-cta-lead hiw-copy-cta">
        {copy.cta.lead}
      </p>
      <p class="hiw-cta-format mt-md hiw-copy-cta">
        {copy.cta.formatNote}
      </p>
      <div class="hiw-cta-actions mt-lg">
        <div class="hiw-cta-actions-row">
          <button type="button" class="btn hiw-cta-btn-white" data-open-booking>
            {copy.cta.bookLabel}
          </button>
          <a href="/contact" class="btn btn--outline-light hiw-cta-btn-message">{copy.cta.messageLabel}</a>
        </div>
        <div class="hiw-cta-linkedin-row">
          <a
            href="https://www.linkedin.com/in/lilidavidis/"
            target="_blank"
            rel="noopener noreferrer"
            class="hiw-cta-link-linkedin"
            aria-label={`${copy.cta.linkedinLabel} (opens in a new tab)`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0;">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            {copy.cta.linkedinLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<!-- Global keyframes — prefixed hiw- to avoid any cross-page name collision -->
<style is:global>
  @keyframes hiw-heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hiw-ctaBgShift {
    0%, 100% { background-color: #4A6B8A; }
    50%      { background-color: #5B7E6F; }
  }

  @keyframes hiw-blendBarBgShift {
    0%, 100% { background-color: var(--eucalyptus); }
    50%      { background-color: var(--slate); }
  }

  @keyframes hiw-blendRevealLeft {
    from { opacity: 0; transform: translateX(24px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes hiw-blendRevealRight {
    from { opacity: 0; transform: translateX(-24px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes hiw-blendRuleGrow {
    from { transform: scaleY(0.2); opacity: 0.4; }
    to   { transform: scaleY(1); opacity: 0.72; }
  }

</style>

<script>
  const targets = document.querySelectorAll('[data-animate]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.delay ?? '0', 10);
          setTimeout(() => el.classList.add('is-visible'), delay);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -20px 0px' }
  );
  targets.forEach((el) => observer.observe(el));

  const hiwBlendBar = document.querySelector('.hiw-blend-bar') as HTMLElement | null;
  if (hiwBlendBar) {
    const blendObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            hiwBlendBar.classList.remove('is-visible');
            void hiwBlendBar.offsetWidth;
            hiwBlendBar.classList.add('is-visible');
          } else {
            hiwBlendBar.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.45 }
    );
    blendObserver.observe(hiwBlendBar);
  }

  // Animated wave divider under hero
  (function () {
    const svg = document.getElementById('help-accent-wave-svg') as SVGSVGElement | null;
    const path = document.getElementById('help-accent-wave-path') as SVGPathElement | null;
    const clip = document.querySelector('.wave-clip') as HTMLElement | null;
    if (!svg || !path || !clip) return;

    const reducedMotionWave = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotionWave) return;

    requestAnimationFrame(() => {
      const W = (clip.parentElement as HTMLElement).getBoundingClientRect().width || window.innerWidth;
      const H = 24;
      const CY = -2;
      const AMPLITUDE = 4.6;
      const POINTS = 180;

      svg.setAttribute('width', String(W));
      svg.setAttribute('height', String(H));
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

      function buildFlatPath(): string {
        const pts: string[] = [];
        for (let i = 0; i <= POINTS; i++) {
          const x = (i / POINTS) * W;
          pts.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${CY.toFixed(2)}`);
        }
        return pts.join(' ');
      }

      function buildWavePacketPath(p: number): string {
        const pts: string[] = [];
        const centerX = W * (0.32 + 0.48 * p);
        const packetWidth = W * 0.34;
        const cycles = 4.5;
        for (let i = 0; i <= POINTS; i++) {
          const x = (i / POINTS) * W;
          const dx = x - centerX;
          const tNorm = dx / (packetWidth / 2);
          const envelope = Math.exp(-Math.pow(tNorm, 2) * 2.2);
          const wave = Math.sin(((dx + packetWidth / 2) / packetWidth) * Math.PI * 2 * cycles);
          const y = CY + AMPLITUDE * wave * envelope;
          pts.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`);
        }
        return pts.join(' ');
      }

      function easeInOut(t: number): number {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      path.setAttribute('d', buildFlatPath());
      clip.style.opacity = '0';
      clip.style.transform = 'translateX(0)';

      const FADE_DELAY = 700;
      const FADE_DURATION = 700;
      const MORPH_DURATION = 2100;
      const HOLD_DURATION = 650;
      const EXIT_DURATION = 1200;

      type Phase = 'waiting' | 'fading' | 'morphing' | 'holding' | 'exiting' | 'done';
      let phase: Phase = 'waiting';
      let phaseStart = 0;
      let animStart: number | null = null;

      function tick(ts: number) {
        if (animStart === null) animStart = ts;

        if (phase === 'waiting') {
          if (ts - animStart >= FADE_DELAY) { phase = 'fading'; phaseStart = ts; }
          requestAnimationFrame(tick);
          return;
        }

        if (phase === 'fading') {
          const t = Math.min((ts - phaseStart) / FADE_DURATION, 1);
          const eased = easeInOut(t);
          clip.style.opacity = String(eased);
          if (t < 1) { requestAnimationFrame(tick); return; }
          clip.style.opacity = '1';
          phase = 'morphing';
          phaseStart = ts;
          requestAnimationFrame(tick);
          return;
        }

        if (phase === 'morphing') {
          const t = Math.min((ts - phaseStart) / MORPH_DURATION, 1);
          path.setAttribute('d', buildWavePacketPath(easeInOut(t)));
          if (t < 1) { requestAnimationFrame(tick); return; }
          phase = 'holding';
          phaseStart = ts;
          requestAnimationFrame(tick);
          return;
        }

        if (phase === 'holding') {
          if (ts - phaseStart >= HOLD_DURATION) { phase = 'exiting'; phaseStart = ts; }
          requestAnimationFrame(tick);
          return;
        }

        if (phase === 'exiting') {
          const t = Math.min((ts - phaseStart) / EXIT_DURATION, 1);
          const eased = t * t;
          clip.style.transform = `translateX(${110 * eased}%)`;
          clip.style.opacity = String(Math.max(0, 1 - eased * 1.4));
          if (t < 1) { requestAnimationFrame(tick); return; }
          phase = 'done';
        }
      }

      requestAnimationFrame(tick);
    });
  })();
</script>

<style>
  /* ── ACCENT WORD ── */
  .accent-word {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ── HERO LOAD ANIMATIONS ── */
  .hero-anim          { animation: hiw-heroFadeUp 0.9s ease both; }
  .hero-anim--1       { animation-delay: 0.15s; }
  .hero-anim--2       { animation-delay: 0.38s; }

  /* ── PAGE HERO ── */
  .page-hero h1 {
    margin-top: 0;
  }

  .wave-wrap {
    width: 100%;
    height: 0;
    overflow: visible;
    display: block;
    background: transparent;
    position: relative;
    margin: 0;
    z-index: 20;
    pointer-events: none;
  }

  .wave-clip {
    width: 100%;
    height: 24px;
    overflow: visible;
    transform: translateY(-15px);
  }

  #help-accent-wave-svg {
    display: block;
    overflow: visible;
  }

  /* ── SCROLL REVEAL ── */
  [data-animate] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.75s ease, transform 0.75s ease;
  }

  [data-animate="fade-right"] { transform: translateX(-36px); }
  [data-animate="fade-left"]  { transform: translateX(36px); }
  [data-animate].is-visible   { opacity: 1; transform: none; }

  /* ── SERVICE LAYOUT ── */
  .service-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .service-meta {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-md));
  }

  .service-meta h2 {
    margin-top: 0;
  }

  .service-name-box {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.84rem;
    background-color: var(--slate);
    color: var(--stone);
    font-family: var(--font-serif);
    font-size: inherit;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1;
    animation: logoBgShift 7s linear infinite;
  }

  .service-quote--meta {
    margin-top: var(--space-lg);
    margin-bottom: 0;
  }

  /* ── SERVICE BODY ── */
  .service-body p {
    max-width: 56ch;
  }

  .service-intro {
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    line-height: 1.35;
    margin: 0 0 var(--space-sm);
    max-width: 90%;
  }

  .subsection-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
    line-height: 1.3;
  }

  .service-body .outcomes-list {
    margin-top: var(--space-sm);
    border-left: none;
    padding-left: 0;
  }

  .service-body .outcomes-list + .subsection-label {
    margin-top: var(--space-lg);
  }

  .service-body .service-list li {
    color: var(--ink-soft);
    font-size: 1.0625rem;
    line-height: 1.6;
    padding: 0.2rem 0;
  }

  .service-body .service-list li::before {
    content: '◆';
    color: color-mix(in srgb, var(--eucalyptus) 60%, var(--slate) 40%);
    font-size: 0.58rem;
    margin-right: 0.7rem;
    flex-shrink: 0;
    font-weight: 400;
    margin-top: 0.35em;
  }

  /* ── PULL-QUOTE CARD ── */
  .service-quote {
    margin: var(--space-md) 0 var(--space-lg);
    padding: 0;
    border: none;
    box-shadow: none;
    background: transparent;
    animation: none;
    text-align: left;
  }

  .service-quote-icon {
    display: block;
    margin-bottom: var(--space-xs);
    color: #BCA985;
    text-align: left;
  }

  .service-quote-icon svg {
    width: 32px;
    height: 32px;
    display: block;
    transform: none;
    stroke: #BCA985;
    color: #BCA985;
  }

  .service-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.62;
    font-weight: 500;
    color: var(--ink-soft);
    max-width: none;
  }

  .hiw-training-inner h2 {
    max-width: 20ch;
    margin-inline: auto;
    text-align: center;
  }

  /* Default --stone band (same as non-alt sections site-wide) */
  .case-callout-section {
    background-color: var(--stone);
  }

  .faq-section {
    background-color: var(--stone);
  }

  /* Slightly darker than adjacent training (body --stone) for clear separation */
  .testimonials-section {
    background-color: var(--stone-mid);
  }

  .hiw-copy-narrow {
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
  }

  .hiw-copy-wide {
    max-width: 68ch;
    margin-inline: auto;
    text-align: center;
  }

  .hiw-copy-cta {
    margin-inline: auto;
    max-width: 52ch;
  }

  /* ── BLEND BAR (home-style strip) ── */
  .hiw-blend-bar {
    position: relative;
    background-color: var(--eucalyptus);
    padding: var(--space-lg) 0;
    overflow: hidden;
    margin-top: 0;
    animation: hiw-blendBarBgShift 7.5s linear infinite;
  }

  .hiw-blend-bar-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(231, 239, 234, 0.24) 0%,
      transparent 45%,
      rgba(215, 225, 236, 0.24) 100%
    );
    pointer-events: none;
  }

  .hiw-blend-text {
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    line-height: 1.26;
    max-width: none;
    color: var(--white);
    margin: 0;
  }

  .hiw-blend-slot {
    display: inline-block;
    overflow: hidden;
    max-width: 100%;
  }

  .hiw-blend-sharp {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #f4f1eb;
    opacity: 0;
    transform: translateX(24px);
  }

  .hiw-blend-human {
    display: inline-block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--stone-mid);
    font-size: 1.05em;
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateX(-24px);
  }

  .hiw-blend-rule {
    display: inline-block;
    width: 2px;
    height: 26px;
    background: linear-gradient(to bottom, #9eb5a8, #8ea4bc);
    opacity: 0.72;
    border-radius: 1px;
    vertical-align: middle;
    flex-shrink: 0;
    transform: scaleY(0.2);
    transform-origin: center;
  }

  .hiw-blend-bar.is-visible .hiw-blend-rule {
    animation: hiw-blendRuleGrow 0.45s var(--ease) 0.05s both;
  }

  .hiw-blend-bar.is-visible .hiw-blend-sharp {
    animation: hiw-blendRevealLeft 0.6s var(--ease) 0.12s both;
  }

  .hiw-blend-bar.is-visible .hiw-blend-human {
    animation: hiw-blendRevealRight 0.6s var(--ease) 0.52s both;
  }

  /* ── CLOSING CTA ── */
  .hiw-cta-section {
    padding-block: var(--space-2xl);
    background-color: #4A6B8A;
    animation: hiw-ctaBgShift 7.5s linear infinite;
  }

  .hiw-cta-heading {
    color: #F4F1EB;
    max-width: 28ch;
    margin-inline: auto;
  }

  .hiw-cta-lead {
    color: #DDD6C8;
  }

  .hiw-cta-format {
    color: #E6E0D4;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-inline: auto;
  }

  .hiw-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hiw-cta-actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.65rem 0.85rem;
  }

  .hiw-cta-linkedin-row {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hiw-cta-link-linkedin {
    display: inline-flex;
