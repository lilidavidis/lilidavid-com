---
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="brand-name">Lili David</span>
    </a>
    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle-bars" aria-hidden="true">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </span>
    </button>
    <ul class="nav-links" id="primary-nav" role="list">
      <li><a href="/" class:list={[{ active: isActive('/') }]}>Home</a></li>
      <li><a href="/working-together" class:list={[{ active: isActive('/working-together') }]}>Working Together</a></li>
      <li><a href="/about" class:list={[{ active: isActive('/about') }]}>About</a></li>
      <li>
        <a href="/contact" class="nav-cta" class:list={[{ active: isActive('/contact') }]}>Get in touch</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  function initMobileNav() {
    const nav = document.querySelector('.site-nav');
    const toggle = document.getElementById('nav-toggle');
    const backdrop = document.getElementById('nav-backdrop');
    const panel = document.getElementById('primary-nav');
    if (!nav || !toggle || !backdrop || !panel) return;

    const mq = window.matchMedia('(max-width: 880px)');
    let open = false;

    function setOpen(next: boolean) {
      open = next;
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-no-scroll', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    function closeIfNeeded() {
      if (open) setOpen(false);
    }

    toggle.addEventListener('click', () => setOpen(!open));
    backdrop.addEventListener('click', closeIfNeeded);
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeIfNeeded));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeIfNeeded();
    });

    const onMq = () => {
      if (!mq.matches) {
        nav.classList.remove('is-open');
        document.body.classList.remove('nav-no-scroll');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        open = false;
      }
    };
    mq.addEventListener('change', onMq);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav);
  } else {
    initMobileNav();
  }
</script>
